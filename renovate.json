{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "lockFileMaintenance": {
    "enabled": false
  },
  "cloneSubmodules": true,
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "nix"
      ],
      "matchDepNames": [
        "private"
      ],
      "enabled": false
    }
  ]
}
